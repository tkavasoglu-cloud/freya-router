# ============================================================
# FREYA YACHTING — Railway Environment Variables
# Railway Dashboard > Variables bölümüne bunları ekle
# ============================================================

# n8n Webhook URL (n8n Cloud'daki webhook adresin)
N8N_WEBHOOK_URL=https://SENIN-N8N.app.n8n.cloud/webhook/whatsapp-ai

# Instagram / Meta Ayarları
IG_ACCESS_TOKEN=Meta_Developer_dan_aldigin_access_token
IG_VERIFY_TOKEN=FREYA_VERIFY_2024
IG_APP_SECRET=Meta_Developer_dan_aldigin_app_secret

# Admin bilgilendirme telefonu
ADMIN_PHONE=+905XXXXXXXXX

# Twilio REST ile WhatsApp cevabi (API Key; Auth Token DEGIL). Ucu de doluysa kullanilir, yoksa TwiML ile cevap verilir
TWILIO_ACCOUNT_SID=Twilio_Console_dan_account_sid
TWILIO_API_KEY_SID=Twilio_Console_dan_api_key_sid
TWILIO_API_KEY_SECRET=Twilio_Console_dan_api_key_secret
